APP_NAME=Port Pass Management
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=postgresql+psycopg2://postgres:admin123@127.0.0.1:5432/port_pass_db
CORS_ORIGINS=*

# ── HA / DR Configuration ─────────────────────────────────────────
SERVER_ROLE=primary
# STANDBY_HOST=192.168.1.101
# PRIMARY_HOST=192.168.1.100

# ── Backup Configuration ──────────────────────────────────────────
BACKUP_DIR=backups
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
BACKUP_RETENTION_MONTHLY=6
BACKUP_DB_HOST=127.0.0.1
BACKUP_DB_PORT=5432
BACKUP_DB_NAME=port_pass_db
BACKUP_DB_USER=postgres
BACKUP_DB_PASSWORD=admin123

# ── Health Monitoring Thresholds ──────────────────────────────────
DISK_WARNING_THRESHOLD=80
DISK_CRITICAL_THRESHOLD=90
REPLICATION_LAG_WARNING=30
REPLICATION_LAG_CRITICAL=120
